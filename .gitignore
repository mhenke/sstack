# Superpowers process artifacts (specs, plans, workspace) — local only.
# The durable decisions live in docs/adr/.
docs/superpowers/
.superpowers/

# Python
__pycache__/
*.pyc

# sstack run artifacts (runtime output of the skill, not source).
# config.md and lenses/ are authored, not generated: keep them versionable.
.sstack/*
!.sstack/config.md
!.sstack/lenses/
.pytest_cache/

# Node
node_modules/
